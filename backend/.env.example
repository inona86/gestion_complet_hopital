# Copiez ce fichier en ".env" (même dossier) et ajustez les valeurs.
# Le fichier ".env" ne doit jamais être partagé/commité — il est déjà dans .gitignore.

# ── Base de données MySQL ────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=hopitals

# ── Serveur ───────────────────────────────────────────────────────────────────
PORT=3000

# ── Authentification ──────────────────────────────────────────────────────────
# Obligatoire en production : une longue chaîne aléatoire secrète.
# Génération rapide : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-moi-avant-la-mise-en-ligne

# ── Emails (notifications de rendez-vous) ────────────────────────────────────
# Laissez ces 3 lignes vides/absentes pour utiliser automatiquement un compte
# de test Ethereal (aucun envoi réel, lien de prévisualisation dans la console).
# Pour un vrai envoi via Gmail par exemple :
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=votre-adresse@gmail.com
#   SMTP_PASS=un-mot-de-passe-d-application (pas votre mot de passe Gmail normal)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
